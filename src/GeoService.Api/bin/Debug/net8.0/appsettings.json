{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GeoService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "GeolocationProviders": {
    "Geoapify": {
      "ApiKey": "REPLACE_WITH_YOUR_GEOAPIFY_KEY",
      "Enabled": true
    },
    "IpStack": {
      "ApiKey": "REPLACE_WITH_YOUR_IPSTACK_KEY",
      "Enabled": true
    },
    "Ip2Location": {
      "ApiKey": "REPLACE_WITH_YOUR_IP2LOCATION_KEY",
      "Enabled": true
    }
  }
}
